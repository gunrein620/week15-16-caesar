# ── Database ──────────────────────────────────────────────
# 로컬 PostgreSQL에 아래 개발용 role/database를 만든 뒤 사용하세요.
#   CREATE USER jungle WITH PASSWORD 'jungle';
#   CREATE DATABASE jungle_market OWNER jungle;
DATABASE_URL="postgresql://jungle:jungle@localhost:5432/jungle_market"

# ── Auth.js ───────────────────────────────────────────────
# `npx auth secret` 또는 `openssl rand -base64 32`로 생성
AUTH_SECRET="changeme"

# 소셜 로그인 (키를 넣으면 로그인 화면에서 해당 버튼이 활성화됨)
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 개발용 게스트 로그인 (OAuth 키 없이 플로우 테스트). 운영에서는 비우거나 0.
GUEST_LOGIN="1"
