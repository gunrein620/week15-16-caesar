{
  "name": "junglebob",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @junglebob/db prisma:generate",
    "db:migrate": "pnpm --filter @junglebob/db prisma:migrate"
  }
}
